# LiveKit Cloud project: https://cloud.livekit.io -> Settings -> Project (WebSocket URL) and Settings -> Keys
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=

# Optional: leave empty to run without the avatar (voice + vision only)
TAVUS_API_KEY=
# Optional: a stock or custom face from https://docs.tavus.io/sections/faces/stock-faces
TAVUS_FACE_ID=
